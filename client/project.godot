; Engine configuration file.
; 浮生录 — Godot 4 客户端。版本锁定 4.7.2-stable。
; 详细设置见 https://docs.godotengine.org/en/stable/

config_version=5

[application]

config/name="浮生录"
config/description="开放式人生文字沙盒（客户端权威本地玩法，可离线）。"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://ui/main.tscn"
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
WorldClock="*res://autoload/world_clock.gd"
TickScheduler="*res://autoload/tick_scheduler.gd"
SpeedController="*res://autoload/speed_controller.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[internationalization]

locale/fallback="zh_CN"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
