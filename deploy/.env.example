# 复制为 .env 后填入真实值，.env 已被 .gitignore 忽略。
# 生成密钥：openssl rand -base64 32

JWT_SECRET=replace-with-at-least-32-bytes

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

POSTGRES_USER=life
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=life

# MinIO 根账号仅用于初始化与运维，日常构建使用 ci-rw。
MINIO_ROOT_USER=lifetext-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
MINIO_DATA_DIR=/srv/lifetext/minio/data

OBJECT_ENDPOINT=minio:9000
OBJECT_REGION=
OBJECT_USE_SSL=false
OBJECT_CREATE_BUCKET=true
OBJECT_BUCKET=lifetext
OBJECT_ACCESS_KEY=lifetext-server
OBJECT_SECRET_KEY=replace-with-a-strong-password

CI_ACCESS_KEY=ci-rw
CI_SECRET_KEY=replace-with-a-strong-password

TELEMETRY_RETENTION_DAYS=90
