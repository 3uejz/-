{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-text-sandbox/shared/schemas/disaster.schema.json",
  "title": "Disaster",
  "description": "灾害与救援事件（D36）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "region_id", "started_minutes"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "kind": { "type": "string", "enum": ["earthquake", "flood", "typhoon", "wildfire", "pandemic", "industrial", "war", "other"] },
    "region_id": { "$ref": "common.schema.json#/$defs/content_key" },
    "started_minutes": { "$ref": "common.schema.json#/$defs/absolute_minutes" },
    "ended_minutes": { "$ref": "common.schema.json#/$defs/absolute_minutes" },
    "severity": { "type": "number", "minimum": 0, "maximum": 100 },
    "status": { "type": "string", "enum": ["ongoing", "contained", "recovering", "ended"] },
    "casualties": { "type": "integer", "minimum": 0 },
    "injured": { "type": "integer", "minimum": 0 },
    "displaced": { "type": "integer", "minimum": 0 },
    "economic_loss": { "$ref": "common.schema.json#/$defs/money" },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "responding_units": { "type": "integer", "minimum": 0 },
        "response_minutes": { "$ref": "common.schema.json#/$defs/duration_minutes" },
        "triage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "red": { "type": "integer", "minimum": 0 },
            "yellow": { "type": "integer", "minimum": 0 },
            "green": { "type": "integer", "minimum": 0 },
            "black": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "policy_keys": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/content_key" } }
  }
}
